# =============================================================================
# Backend Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your real values in .env
# =============================================================================

# ── Vercel AI Gateway (Main Agent + Feeder Agent + Gemini image editing) ───────
# Get at: vercel.com/dashboard → AI → Gateway → Create Token
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
# Note: OPENAI_API_KEY and OPENAI_BASE_URL are no longer needed — replaced by AI_GATEWAY_API_KEY

# ── LangSmith (required for LangGraph server) ─────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here

# ── Tavily (web search) ────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Linkup (web search) ────────────────────────────────────────────────────────
LINKUP_API_KEY=your_linkup_api_key_here

# ── Brave Search (image search) ────────────────────────────────────────────────
BRAVE_API_KEY=your_brave_api_key_here

# ── Exa AI (fallback extract) ────────────────────────────────────────────────
EXA_API_KEY=your_exa_api_key_here

# ── Parallel AI (fallback search) ──────────────────────────────────────────
PARALLEL_API_KEY=your_parallel_ai_key_here


# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Supabase Database Password (required for automatic migrations/setup)
SUPABASE_DB_PASSWORD=your_database_password_here
# Optional Database Port (defaults to 5432)
# SUPABASE_DB_PORT=5432

# ── Composio MCP Gateway ───────────────────────────────────────────────────────
# Get your free API key at: https://app.composio.dev
# This connects 1000+ tools (Gmail, GitHub, Slack, Notion...) to your agents
COMPOSIO_API_KEY=your_composio_api_key_here

# ── Pinecone ───────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-news-feeder

# ── Next.js app URL (for cron auto-publish) ────────────────────────────────
NEXT_APP_URL=http://localhost:3000

# ── Cerebras (Feeder Dedup Agent) ──────────────────────────────────────────────
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ── KIE AI (Image editing — used by the Python agent) ─────────────────────────
KIE_API_KEY=your_kie_ai_api_key_here

# ── Next.js app URL (cron scheduler POSTs here to trigger auto-publish) ────────
# Set this to wherever your Next.js frontend is running.
# The Python cron_scheduler.py reads this as NEXT_APP_URL or NEXT_PUBLIC_APP_URL.
NEXT_APP_URL=http://localhost:3000

# NOTE: Social platform credentials (FB_TOKEN, FB_PAGE_ID, IG_ACCOUNT_ID,
# TWITTER_API_KEY, etc.) go in the FRONTEND env file:
#   deep-agents-ui-main/.env.local
# They are read by the Next.js /api/publish route, not by Python.

# ── WordPress Blog Publisher ────────────────────────────────────────────────────
# Your WordPress site URL (must be HTTPS in production)
WP_SITE_URL=https://yoursite.com

# WordPress admin username (the one you log in with)
WP_USERNAME=your_wp_admin_username

# WordPress Application Password — NOT your login password!
# Generate it: WP Admin → Users → Profile → Application Passwords → Add New
# It looks like: xxxx xxxx xxxx xxxx xxxx xxxx (spaces are fine, keep them)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Post status: "draft" (safe, review before going live) or "publish" (immediate)
# Start with "draft" until you are happy with the output quality.
WP_POST_STATUS=draft

# ── DeepSeek ───────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZERO_ENTROPY_API_KEY=your_zero_entropy_api_key_here

# ── Graph Memory (Neo4j) ───────────────────────────────────────────────────────
# Set to true to enable relationship-aware graph memory (requires Neo4j running).
# Leave false to use Pinecone vector memory only (no Neo4j needed).
GRAPH_MEMORY_ENABLED=false

# LOCAL development (running uv run locally):
#   NEO4J_URI=bolt://localhost:7687
#
# SERVER / Docker deployment (running via deploy.sh / docker-compose):
#   NEO4J_URI=bolt://neo4j:7687   <-- use Docker service name, NOT localhost
#
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── Redis Cache Server ────────────────────────────────────────────────────────
# Leave blank to bypass Redis and use Supabase directly.
# Local development: redis://127.0.0.1:6379
# Docker deployment: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# ── Cloudflare R2 Unified File Storage (optional — Supabase Storage fallback) ──
# Portable file layer: attachments + agent-generated files follow the user across
# deployments (web VPS ↔ PC build). Per-user keys can also be set from the UI
# (Settings → ENV Keys → "File Storage (Cloudflare R2)"); env vars are the fallback.
# Create an R2 API token: Cloudflare dashboard → R2 → Manage API Tokens
# (permission: Object Read & Write, scoped to your bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public access URL of the bucket (enable "Public Development URL" or attach a
# custom domain in bucket Settings). Required for stable shareable file links.
R2_PUBLIC_BASE_URL=
# Default file retention in days (0 = keep forever). Per-user override in UI.
STORAGE_RETENTION_DAYS=30
# Mirror EVERY agent-created file to cloud storage (legacy dual-write). Off by
# default: agent files stay in the thread workspace and are browsable/downloadable
# from the chat's Files panel, while attachments, generated media, social-post
# media, and explicit `upload_to_storage` calls still go to R2/Supabase.
STORAGE_AUTO_UPLOAD_FILES=false

# ── Internal service token for server-to-server API calls ─────────────────────
# cron_scheduler.py and the agent's social savers call the Next.js API
# (/api/publish) without a browser session; they present this token instead.
# Defaults to SUPABASE_SERVICE_ROLE_KEY when unset, so existing deployments keep
# working. Set it to decouple the two secrets.
INTERNAL_API_TOKEN=


