# =============================================================================
# Frontend Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your real values in .env
# =============================================================================

# ── Supabase (NEXT_PUBLIC_ prefix = accessible in browser) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Pinecone (server-side API routes only) ─────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-news-feeder

# ── Facebook / Meta (social posting) ──────────────────────────────────────────
FB_TOKEN=your_facebook_token_here
FB_PAGE_ID=your_facebook_page_id_here
IG_ACCOUNT_ID=your_instagram_account_id_here

# ── Twitter / X (via twitterapi.io) ────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=
TWITTER_PROXY=
TWITTER_TOTP=

# ── DeepSeek ───────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Smithery AI (MCP Server Registry) ─────────────────────────────────────────
# Used for remote Smithery managed connections (per-user key — each user enters
# their own key in the UI when connecting remotely). This env var is OPTIONAL
# and only used as a fallback server-wide default.
# Get your key at: https://smithery.ai/account/api-keys
SMITHERY_API_KEY=your_smithery_api_key_here

# ── Composio (MCP Tool Integrations) ──────────────────────────────────────────
# Get your key at: https://app.composio.dev
COMPOSIO_API_KEY=your_composio_api_key_here
